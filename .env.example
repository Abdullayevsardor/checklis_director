# Backend environment sample

APP_NAME=Shift Checklist API
APP_ENV=production
DEBUG=False

DATABASE_URL=postgresql+asyncpg://checklist:password@postgres:5432/checklist
SECRET_KEY=replace-with-a-secret-key
